# Copy to .env and fill in. Never commit real values.
# docker compose auto-reads .env for ${VAR} substitution.

INFRACOP_QDRANT_URL=http://qdrant:6333
INFRACOP_QDRANT_API_KEY=
INFRACOP_COLLECTION=enterprise_standards

# bedrock | fastembed | hash
# hash = local Docker default (no AWS, no model download)
# bedrock = Amazon Titan V2 (needs AWS credentials)
# fastembed = BGE-small 384-d (install extras: pip install -e ".[local]")
INFRACOP_EMBEDDING_BACKEND=hash
INFRACOP_EMBEDDING_DIMS=1024
INFRACOP_BEDROCK_REGION=us-east-1
INFRACOP_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

INFRACOP_STANDARDS_REPO=telecomprofi/Ent-DevOps-Standards
INFRACOP_GITHUB_TOKEN=
INFRACOP_GITHUB_WEBHOOK_SECRET=

# Comma-separated per-team keys for the MCP HTTP API (empty = open, local only)
INFRACOP_API_KEYS=
INFRACOP_LOG_LEVEL=INFO
INFRACOP_HOST=0.0.0.0
INFRACOP_MCP_PORT=8765
INFRACOP_INGEST_PORT=8766
