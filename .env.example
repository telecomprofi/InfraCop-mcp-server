# Copy to .env and fill in. Never commit real values.

INFRACOP_QDRANT_URL=https://YOUR-CLUSTER.qdrant.io:6333
INFRACOP_QDRANT_API_KEY=
INFRACOP_COLLECTION=enterprise_standards

INFRACOP_BEDROCK_REGION=us-east-1
INFRACOP_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
INFRACOP_EMBEDDING_DIMS=1024

INFRACOP_STANDARDS_REPO=telecomprofi/Ent-DevOps-Standards
INFRACOP_GITHUB_TOKEN=
INFRACOP_GITHUB_WEBHOOK_SECRET=

# Comma-separated per-team keys for the MCP HTTP API
INFRACOP_API_KEYS=
INFRACOP_LOG_LEVEL=INFO
